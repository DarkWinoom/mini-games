{
  "name": "mini-games",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "A web collection of small games (Tetris, Sudoku, N-Puzzle). Vue 3 + Vite + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "sudoku-gen": "^1.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.3",
    "vite": "^5.2.11",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
